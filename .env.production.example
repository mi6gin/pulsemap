APP_NAME=PulseMap
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=pulsemap
DB_USERNAME=pulsemap
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
CACHE_STORE=database

YANDEX_MAPS_CONNECT_TIMEOUT=10
YANDEX_MAPS_TIMEOUT=25
YANDEX_MAPS_PAGE_SIZE=50
YANDEX_MAPS_MAX_PAGES=20
YANDEX_MAPS_AVAILABLE_REVIEWS_LIMIT=600
YANDEX_MAPS_DELAY_MIN_MS=250
YANDEX_MAPS_DELAY_MAX_MS=650
YANDEX_MAPS_REQUESTS_PER_MINUTE=12
YANDEX_MAPS_PROXY=

APP_PORT=8000
POSTGRES_PASSWORD=CHANGE_ME
